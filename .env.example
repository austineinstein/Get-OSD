# Frontend API URL — where the UI will POST explorer requests
VITE_API_URL=http://localhost:3000/api/v1/explore

# Ethereum RPC provider (used by the backend). Replace with your provider URL or key.
# Recommended: Alchemy (best developer experience)
# Example (Alchemy HTTP):
# ETHEREUM_RPC=https://eth-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY

# Other provider examples:
# Infura (HTTP):
# ETHEREUM_RPC=https://mainnet.infura.io/v3/YOUR_INFURA_PROJECT_ID

# QuickNode (HTTP):
# ETHEREUM_RPC=https://YOUR_CUSTOM_ENDPOINT.quiknode.pro/YOUR_KEY/

# Public (no key / not recommended for production):
# ETHEREUM_RPC=https://rpc.ankr.com/eth

# Notes:
# - Use a secure API key in production. Do NOT commit real secrets to the repo.
# - If your provider requires a WebSocket URL for subscriptions, set that in your backend config separately.
# - Restart servers after editing .env files.
